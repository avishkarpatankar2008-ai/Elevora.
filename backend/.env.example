# Copy this file to .env. Never commit a real .env or provider credentials.
# Select free-tier-only provider projects/keys and do not enable billing; see README.

# ----------------------------------------------------------------- environment
ENV=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------- database
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=elevora
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# ----------------------------------------------------------------------- auth
# Required in production. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_NAME=elevora_session
COOKIE_SAMESITE=lax

AUTH_RATE_LIMIT_ENABLED=true
AUTH_LOGIN_RATE_LIMIT=20
AUTH_LOGIN_RATE_WINDOW_SECONDS=60
AUTH_REGISTER_RATE_LIMIT=60
AUTH_REGISTER_RATE_WINDOW_SECONDS=3600

# ----------------------------------------------------- Free-only text AI router
# All credentials stay server-side. Do not add model IDs here: the six model
# IDs are code allowlisted and only free-tier variants are selected.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_REFERER=
AI_TIMEOUT_SECONDS=25
AI_MAX_RETRIES_PER_MODEL=1
AI_MAX_CONCURRENT_REQUESTS=6
AI_CACHE_TTL_SECONDS=60
AI_CACHE_MAX_ENTRIES=128
AI_QUOTA_COOLDOWN_SECONDS=60

# ---------------------------------------------------------------------- uploads
MAX_AUDIO_UPLOAD_BYTES=15728640
MAX_DOCUMENT_UPLOAD_BYTES=8388608
MAX_REQUEST_BYTES=26214400

# ---------------------------------------------------------------------- engine
STALE_CLAIM_SECONDS=120

# ------------------------------------------------------------------------ voice
# Question playback uses browser speech synthesis (no paid server-side TTS).
# Voice-answer transcription uses Groq's free-tier whisper-large-v3-turbo model.
# Speech timing metrics require ffmpeg/ffprobe on the backend host.
