# Copy this file to .env and fill in real values. Never commit the real .env.
# Every variable below is optional in development (the defaults in app/config.py
# are used) and REQUIRED in production where marked.

# ----------------------------------------------------------------- environment
# development | test | production. In production the app refuses to start with
# the development JWT secret, a localhost FRONTEND_ORIGIN, or SameSite=None
# without a secure cookie.
ENV=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------- database
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=elevora
# How long to wait for MongoDB to answer before a request fails (ms).
MONGO_SERVER_SELECTION_TIMEOUT_MS=8000
# How long to wait for MongoDB to answer before failing a request (ms).
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# ----------------------------------------------------------------------- auth
# REQUIRED in production. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Must match the frontend origin exactly (no trailing slash) for cookies + CORS.
FRONTEND_ORIGIN=http://localhost:3000

# Set when the API is behind HTTPS and you want the cookie marked Secure
# explicitly; defaults to "ENV != development".
COOKIE_SECURE=false
# Only set when sharing the session across subdomains, e.g. ".example.com"
COOKIE_DOMAIN=
COOKIE_NAME=elevora_session
# lax | strict | none. "none" requires https and COOKIE_SECURE=true; use it only
# when the frontend and API are on different sites.
# lax | strict | none. "none" requires COOKIE_SECURE=true (rejected otherwise)
# and is only needed when the frontend and API are on different sites.
COOKIE_SAMESITE=lax
# Leave unset to default to "secure whenever ENV != development".
# COOKIE_SECURE=true
# Only needed when sharing the cookie across subdomains, e.g. .example.com
# COOKIE_DOMAIN=

# Brute-force protection for the unauthenticated auth endpoints (per client
# address + email, per API process).
AUTH_RATE_LIMIT_ENABLED=true
AUTH_LOGIN_RATE_LIMIT=20
AUTH_LOGIN_RATE_WINDOW_SECONDS=60
AUTH_REGISTER_RATE_LIMIT=60
AUTH_REGISTER_RATE_WINDOW_SECONDS=3600

# ------------------------------------------------- TEXT AI (OpenRouter) — text
# Key from https://openrouter.ai/keys. Without it, question generation,
# answer analysis, resume/JD extraction, and reports all fail with a clear
# "AI isn't configured" message instead of a crash.
OPENROUTER_API_KEY=
# Any OpenRouter model id. Pick one that supports structured outputs.
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_TIMEOUT_SECONDS=45
OPENROUTER_MAX_ATTEMPTS=2
# Optional attribution header sent as HTTP-Referer on OpenRouter calls.
OPENROUTER_REFERER=

# ------------------------------------------------ VOICE AI (OpenAI) — STT/TTS
# Key from https://platform.openai.com/api-keys. Voice features degrade
# gracefully to text when it is missing.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_ATTEMPTS=2

# -------------------------------------------------------------------- uploads
MAX_AUDIO_UPLOAD_BYTES=15728640
MAX_DOCUMENT_UPLOAD_BYTES=8388608
MAX_REQUEST_BYTES=26214400

# --------------------------------------------------------------------- engine
# How long a start/answer/report operation may hold its claim before another
# request may take over. Bounds the damage of a killed request.
STALE_CLAIM_SECONDS=120

# ---------------------------------------------------------------------- system
# Speech analytics (pace, pauses, fillers) shell out to ffmpeg/ffprobe. Install
# both on the host/container, or voice answers are stored without delivery
# metrics and the Delivery dimension reports "Not available" instead of a guess:
#   Debian/Ubuntu: apt-get install -y ffmpeg
#   macOS: brew install ffmpeg
# Verified with ffmpeg 5.x/6.x; the tests skip themselves when it is missing.
