# ---------------------------------------------------------------------- engine
STALE_CLAIM_SECONDS=120

# ------------------------------------------------------------------------ voice
# Question playback uses browser speech synthesis (no paid server-side TTS).
# Voice-answer transcription uses Groq's free-tier whisper-large-v3-turbo model.
# Speech timing metrics require ffmpeg/ffprobe on the backend host.

# --- Privacy / abuse limits -------------------------------------------------
# Users are in PRIVATE mode by default: nothing they provide goes to an external
# AI provider unless they explicitly consent in Settings -> Privacy. Provider keys
# above are therefore only used for consenting users.
# Per-user cap on requests that can reach an external AI provider.
AI_USER_RATE_LIMIT=30
AI_USER_RATE_WINDOW_SECONDS=60
=======
# --------------------------------------------------------------------- engine
# How long a start/answer/report operation may hold its claim before another
# request may take over. Bounds the damage of a killed request.
STALE_CLAIM_SECONDS=120

# ---------------------------------------------------------------------- system
# Speech analytics (pace, pauses, fillers) shell out to ffmpeg/ffprobe. Install
# both on the host/container, or voice answers are stored without delivery
# metrics and the Delivery dimension reports "Not available" instead of a guess:
#   Debian/Ubuntu: apt-get install -y ffmpeg
#   macOS: brew install ffmpeg
# Verified with ffmpeg 5.x/6.x; the tests skip themselves when it is missing.
