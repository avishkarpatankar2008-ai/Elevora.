# Copy to .env.local (git-ignored) and adjust. Nothing here is required for
# local development with the default setup: the frontend proxies /api/* to
# 127.0.0.1:8000, which is where `uvicorn app.main:app --reload` listens.

# Where the FastAPI service is reachable FROM THE NEXT.JS SERVER (not the
# browser). Used by the /api/* rewrite. In containers this is the service name,
# e.g. http://backend:8000.
BACKEND_ORIGIN=http://127.0.0.1:8000

# Only set this if the browser must call a DIFFERENT origin than the one
# serving the app. Leave it unset to use the same-origin /api proxy (recommended:
# the session cookie stays first-party). If you do set it, that origin must be
# in the backend's FRONTEND_ORIGIN and served over HTTPS in production.
# NEXT_PUBLIC_API_URL=https://api.example.com

