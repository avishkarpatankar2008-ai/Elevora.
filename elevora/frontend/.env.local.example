# Face and pose models used for optional on-device camera analytics. Raw frames
# and landmarks never leave the browser. For offline deployments, self-host both
# model files under frontend/public/mediapipe/models and use same-origin paths.
# NEXT_PUBLIC_FACE_LANDMARKER_MODEL_URL=https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/1/face_landmarker.task
# NEXT_PUBLIC_POSE_LANDMARKER_MODEL_URL=https://storage.googleapis.com/mediapipe-models/pose_landmarker/pose_landmarker_lite/float16/1/pose_landmarker_lite.task
